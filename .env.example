# Application
PORT=3000
JWT_SECRET=replace-with-a-long-random-secret

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=studiobook_db
POSTGRES_PORT=5434

# Used when NestJS runs directly on the host machine
# Note: Local NestJS development uses `localhost`.
# Docker Compose overrides `DATABASE_URL` inside the application container and uses the hostname `db`.
# Production deployments must use secure database credentials and a strong JWT secret.
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/studiobook_db?schema=public"

# Optional development seed administrator
# These values are only for local development seed data.
# SEED_ADMIN_EMAIL and SEED_ADMIN_PASSWORD must be supplied together.
# Leaving email and password blank seeds services only.
# SEED_ADMIN_NAME is optional (if omitted, "Studio Admin" is used).
# The seed password must be at least 6 characters to meet the API validation requirements.
# Real production credentials must never be committed to the repository.
SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
